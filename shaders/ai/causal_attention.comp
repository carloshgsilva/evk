#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable

CONSTANT(0) uint N = 16u;
CONSTANT(1) uint D = 16u;
CONSTANT(2) bool backward = false;

layout(buffer_reference) buffer BufferFp16 { float16_t x[]; };
PUSH(
    BufferFp16 a;
    BufferFp16 b;
    BufferFp16 v;
    BufferFp16 probabilities;
    BufferFp16 outputBuffer;
    float scale;
)

shared float16_t tile[16u * (N + 8u)];
shared float16_t queryTile[16u * (D + 8u)];

// Forward: softmax(causal(Q K^T) * scale) V, saving FP16 probabilities.
// Backward: dP = dO V^T; dS = P * (dP - row_sum(P * dP)) * scale.
// Shared row padding avoids bank conflicts in the cooperative matrix loads.

COMPUTE(512, 1, 1)
void main() {
    uint batch = gl_WorkGroupID.z;
    uint row = gl_WorkGroupID.y * 16u;
    uint warp = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint vectorBase = batch * N * D;
    uint scoreBase = batch * N * N;

    for (uint index = gl_LocalInvocationID.x; index < 16u * D; index += 512u)
        queryTile[(index / D) * (D + 8u) + index % D] = a.x[vectorBase + row * D + index];
    barrier();

    // Keep the same FP16 dot-product rounding as the unfused matmul path.
    for (uint col = warp * 16u; col < N; col += 256u) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> score =
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
        if (col <= row) {
            for (uint feature = 0u; feature < D; feature += 16u) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> lhs;
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> rhs;
                coopMatLoad(lhs, queryTile, feature, D + 8u, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(rhs, b.x, vectorBase + col * D + feature, D,
                            gl_CooperativeMatrixLayoutColumnMajor);
                score = coopMatMulAdd(lhs, rhs, score);
            }
        }
        coopMatStore(score, tile, col, N + 8u, gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();

    for (uint r = warp; r < 16u; r += 16u) {
        float maximum = -3.402823466e+38;
        if (!backward) {
            for (uint col = lane; col < N; col += 32u) {
                float raw = float(tile[r * (N + 8u) + col]);
                if (col <= row + r && !(raw <= -65504.0))
                    maximum = max(maximum, raw * scale);
            }
            maximum = subgroupMax(maximum);
        }
        float sum = 0.0;
        for (uint col = lane; col < N; col += 32u) {
            float value = float(tile[r * (N + 8u) + col]);
            if (col <= row + r && (backward || !(value <= -65504.0))) {
                sum += backward ? value * float(probabilities.x[scoreBase + (row + r) * N + col])
                                : exp(value * scale - maximum);
            }
        }
        sum = subgroupAdd(sum);
        float invSum = 1.0 / max(sum, 1.0e-20);
        for (uint col = lane; col < N; col += 32u) {
            uint index = scoreBase + (row + r) * N + col;
            float value = 0.0;
            float raw = float(tile[r * (N + 8u) + col]);
            if (col <= row + r && (backward || !(raw <= -65504.0))) {
                value = backward ? float(probabilities.x[index]) * (raw - sum) * scale
                                 : exp(raw * scale - maximum) * invSum;
            }
            if (backward)
                outputBuffer.x[index] = float16_t(value);
            else {
                tile[r * (N + 8u) + col] = float16_t(value);
                probabilities.x[index] = float16_t(value);
            }
        }
    }
    if (backward)
        return;
    barrier();

    for (uint feature = warp * 16u; feature < D; feature += 256u) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> result =
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
        for (uint col = 0u; col <= row; col += 16u) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> p;
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> value;
            coopMatLoad(p, tile, col, N + 8u, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(value, v.x, vectorBase + col * D + feature, D,
                        gl_CooperativeMatrixLayoutRowMajor);
            result = coopMatMulAdd(p, value, result);
        }
        coopMatStore(result, outputBuffer.x, vectorBase + row * D + feature, D,
                     gl_CooperativeMatrixLayoutRowMajor);
    }
}
