#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(buffer_reference) buffer BufferU16 { uint16_t x[]; };
layout(buffer_reference) buffer BufferFp16 { float16_t x[]; };
#include "fp16_stats.glsl"

PUSH(
    BufferU16 targetBuffer;   // (totalPositions)
    BufferFp16 accumBuffer;   // valid count in three numeric FP16 components
    uint totalPositions;      // B * N
    uint vocabSize;           // V
)

const uint MAX_SUBGROUPS = 64;
shared uint sharedCounts[MAX_SUBGROUPS];

// One workgroup counts valid targets without a persisted FP32 atomic buffer.
COMPUTE(256, 1, 1)
void main() {
    uint gid = gl_GlobalInvocationID.x;

    uint subgroupId = gl_SubgroupID;
    uint subgroupLane = gl_SubgroupInvocationID;
    uint subgroupCount = gl_NumSubgroups;

    uint localCount = 0u;
    for (uint i = gid; i < totalPositions; i += gl_WorkGroupSize.x) {
        uint t = uint(targetBuffer.x[i]);
        localCount += (t != 0u && t < vocabSize) ? 1u : 0u;
    }

    uint subgroupTotal = subgroupAdd(localCount);
    if (subgroupLane == 0) {
        sharedCounts[subgroupId] = subgroupTotal;
    }
    barrier();

    if (subgroupId == 0 && subgroupLane == 0) {
        uint total = 0u;
        uint limit = min(subgroupCount, MAX_SUBGROUPS);
        for (uint s = 0u; s < limit; ++s) {
            total += sharedCounts[s];
        }
        write_fp16_stat(accumBuffer, 0u, float(total));
    }
}


