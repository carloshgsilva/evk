#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable

layout(buffer_reference) buffer BufferFp16 { float16_t x[]; };
#include "fp16_stats.glsl"

PUSH(
    BufferFp16 resultBuffer; // scalar loss output
    BufferFp16 accumBuffer;  // valid count followed by per-row loss terms
    uint totalPositions;
)

// Write mean loss (grads are already scaled in cross_entropy.comp)
// FP32 is temporary reduction scratch inside this dispatch, never persisted.
shared float partial[64];
COMPUTE(256, 1, 1)
void main() {
    float local = 0.0;
    for (uint row = gl_LocalInvocationID.x; row < totalPositions; row += 256u)
        local += read_fp16_stat(accumBuffer, 3u * (row + 1u));
    float sum = subgroupAdd(local);
    if (gl_SubgroupInvocationID == 0u) partial[gl_SubgroupID] = sum;
    barrier();
    if (gl_LocalInvocationID.x != 0u) return;
    float loss = 0.0;
    for (uint i = 0u; i < gl_NumSubgroups; ++i) loss += partial[i];
    if (isnan(loss) || isinf(loss)) {
        loss = 0.0;
    }
    resultBuffer.x[0] = float16_t(loss);
}

