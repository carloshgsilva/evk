#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(buffer_reference) buffer BufferFp16 { float16_t x[]; };

PUSH(
    BufferFp16 projectionBuffer;
    BufferFp16 stateHistoryBuffer;
    BufferFp16 gradOutputBuffer;
    BufferFp16 gradProjectionBuffer;
    BufferFp16 gradStateBoundaryBuffer;
    uint batchSize;
    uint sequenceLength;
    uint modelDim;
    uint headCount;
    float ropeBase;
    float decayBias;
    uint chunkSize;
)

CONSTANT(0) uint headDim = 4u;

uint historyIndex(uint row, uint head, uint headDim,
                  uint keyFeature, uint valueFeature) {
    return ((((row * headCount + head) * headDim + keyFeature) * headDim) + valueFeature);
}

float previousState(uint batch, uint position, uint head, uint headDim,
                    uint keyFeature, uint valueFeature) {
    if (position == 0u) return 0.0;
    uint row = batch * sequenceLength + position - 1u;
    return float(stateHistoryBuffer.x[
        historyIndex(row, head, headDim, keyFeature, valueFeature)]);
}

float headSum(float value, uint headDim) {
    for (uint offset = headDim / 2u; offset > 0u; offset >>= 1u) {
        value += subgroupShuffleXor(value, offset);
    }
    return value;
}

COMPUTE(32, 1, 1)
void main() {
    uint chunkCount = (sequenceLength + chunkSize - 1u) / chunkSize;
    uint batch = gl_WorkGroupID.x / chunkCount;
    uint chunk = gl_WorkGroupID.x % chunkCount;
    uint lane = gl_LocalInvocationID.x;
    uint headsPerGroup = 32u / headDim;
    uint localHead = lane / headDim;
    uint feature = lane % headDim;
    uint head = gl_WorkGroupID.y * headsPerGroup + localHead;
    uint localBase = localHead * headDim;
    uint globalFeature = head * headDim + feature;
    uint projectionStride = 3u * modelDim + 2u * headCount;
    bool isActive = batch < batchSize && head < headCount;

    // One value column per lane. History and chunk boundaries remain FP16.
    float gradient[headDim];
    for (uint k = 0u; k < headDim; ++k) {
        uint index = ((batch * chunkCount + chunk) * headCount + head) * headDim * headDim +
                     k * headDim + feature;
        gradient[k] = isActive && chunkCount > 1u
            ? float(gradStateBoundaryBuffer.x[index]) : 0.0;
    }

    uint chunkBegin = chunk * chunkSize;
    uint chunkEnd = min(sequenceLength, chunkBegin + chunkSize);
    for (uint reversePosition = chunkEnd; reversePosition > chunkBegin; --reversePosition) {
        uint position = reversePosition - 1u;
        uint row = batch * sequenceLength + position;
        uint projectionStart = row * projectionStride;
        uint vectorStart = row * modelDim + head * headDim;
        uint gateIndex = projectionStart + 3u * modelDim + head;
        uint pair = globalFeature / 2u;
        float angle = float(position) * pow(ropeBase, -2.0 * float(pair) / float(modelDim));
        float c = cos(angle);
        float s = sin(angle);
        float rawQuery = isActive
            ? float(projectionBuffer.x[projectionStart + globalFeature]) : 0.0;
        float rawKey = isActive
            ? float(projectionBuffer.x[projectionStart + modelDim + globalFeature]) : 0.0;
        float pairedQuery = subgroupShuffleXor(rawQuery, 1u);
        float pairedKey = subgroupShuffleXor(rawKey, 1u);
        float rotatedQuery = (feature & 1u) == 0u
            ? rawQuery * c - pairedQuery * s
            : pairedQuery * s + rawQuery * c;
        float rotatedKey = (feature & 1u) == 0u
            ? rawKey * c - pairedKey * s
            : pairedKey * s + rawKey * c;
        rotatedQuery = float(float16_t(rotatedQuery));
        rotatedKey = float(float16_t(rotatedKey));
        float inverseQueryNorm = inversesqrt(
            headSum(rotatedQuery * rotatedQuery, headDim) + 1.0e-6);
        float inverseKeyNorm = inversesqrt(
            headSum(rotatedKey * rotatedKey, headDim) + 1.0e-6);
        float normalizedQuery = rotatedQuery * inverseQueryNorm;
        float normalizedKey = rotatedKey * inverseKeyNorm;
        float decayValue = isActive
            ? 1.0 / (1.0 + exp(float(projectionBuffer.x[gateIndex]) + decayBias))
            : 0.0;
        float writeValue = isActive
            ? 1.0 / (1.0 + exp(-float(projectionBuffer.x[gateIndex + headCount])))
            : 0.0;
        float outputGradient = isActive
            ? float(gradOutputBuffer.x[vectorStart + feature]) : 0.0;

        float queryGradient = 0.0;
        float predicted = 0.0;
        float readGradientValue = 0.0;
        float previous[headDim];
        for (uint k = 0u; k < headDim; ++k) {
            float current = isActive ? float(stateHistoryBuffer.x[
                historyIndex(row, head, headDim, k, feature)]) : 0.0;
            float dq = headSum(current * outputGradient, headDim);
            if (feature == k) queryGradient = dq;
            float headKey = subgroupShuffle(normalizedKey, localBase + k);
            gradient[k] += subgroupShuffle(normalizedQuery, localBase + k) * outputGradient;
            previous[k] = isActive
                ? previousState(batch, position, head, headDim, k, feature) : 0.0;
            predicted += headKey * decayValue * previous[k];
            readGradientValue += gradient[k] * headKey;
        }
        float errorValue = isActive ? float(projectionBuffer.x[
            projectionStart + 2u * modelDim + globalFeature]) - predicted : 0.0;
        float updateGradient = writeValue * readGradientValue;
        if (isActive) {
            gradProjectionBuffer.x[projectionStart + 2u * modelDim + globalFeature] =
                float16_t(updateGradient);
        }

        float keyGradient = 0.0;
        float rowReduction = 0.0;
        for (uint k = 0u; k < headDim; ++k) {
            float dk = headSum(writeValue * gradient[k] * errorValue -
                               decayValue * previous[k] * updateGradient, headDim);
            if (feature == k) keyGradient = dk;
            gradient[k] -= subgroupShuffle(normalizedKey, localBase + k) * updateGradient;
            rowReduction += gradient[k] * previous[k];
            gradient[k] *= decayValue;
        }

        float gradWrite = headSum(readGradientValue * errorValue, headDim);
        float gradDecay = headSum(rowReduction, headDim);
        float queryGradDot = headSum(queryGradient * normalizedQuery, headDim);
        float keyGradDot = headSum(keyGradient * normalizedKey, headDim);
        if (isActive && feature == 0u) {
            gradProjectionBuffer.x[gateIndex] = float16_t(
                gradDecay * (-decayValue * (1.0 - decayValue)));
            gradProjectionBuffer.x[gateIndex + headCount] = float16_t(
                gradWrite * writeValue * (1.0 - writeValue));
        }

        float rotatedQueryGradient = inverseQueryNorm *
            (queryGradient - normalizedQuery * queryGradDot);
        float rotatedKeyGradient = inverseKeyNorm *
            (keyGradient - normalizedKey * keyGradDot);
        rotatedQueryGradient = float(float16_t(rotatedQueryGradient));
        rotatedKeyGradient = float(float16_t(rotatedKeyGradient));
        float pairedQueryGradient = subgroupShuffleXor(rotatedQueryGradient, 1u);
        float pairedKeyGradient = subgroupShuffleXor(rotatedKeyGradient, 1u);
        if (isActive) {
            float rawQueryGradient = (feature & 1u) == 0u
                ? rotatedQueryGradient * c + pairedQueryGradient * s
                : -pairedQueryGradient * s + rotatedQueryGradient * c;
            float rawKeyGradient = (feature & 1u) == 0u
                ? rotatedKeyGradient * c + pairedKeyGradient * s
                : -pairedKeyGradient * s + rotatedKeyGradient * c;
            gradProjectionBuffer.x[projectionStart + globalFeature] =
                float16_t(rawQueryGradient);
            gradProjectionBuffer.x[projectionStart + modelDim + globalFeature] =
                float16_t(rawKeyGradient);
        }
    }
}
