#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_control_flow_attributes : enable

layout(buffer_reference) buffer BufferFp16 { float16_t x[]; };
layout(buffer_reference, buffer_reference_align = 8) buffer BufferFp16x4 { f16vec4 x[]; };

PUSH(
    BufferFp16 projectionBuffer;
    BufferFp16 rawProjectionBuffer;
    BufferFp16 stateHistoryBuffer;
    BufferFp16 gradOutputBuffer;
    BufferFp16 gradProjectionBuffer;
    BufferFp16 gradStateBoundaryBuffer;
    uint batchSize;
    uint sequenceLength;
    uint modelDim;
    uint headCount;
    float ropeBase;
    float decayBias;
    uint chunkSize;
)

CONSTANT(0) uint headDim = 4u;
CONSTANT(1) bool isPrepared = false;

uint historyIndex(uint row, uint head, uint headDim, uint keyFeature, uint valueFeature) {
    return ((((row * headCount + head) * headDim + keyFeature) * headDim) + valueFeature);
}

float headSum(float value, uint headDim) {
    for (uint offset = headDim / 2u; offset > 0u; offset >>= 1u) {
        value += subgroupShuffleXor(value, offset);
    }
    return value;
}

COMPUTE(32, 1, 1)
void main() {
    uint chunkCount = (sequenceLength + chunkSize - 1u) / chunkSize;
    uint batch = gl_WorkGroupID.x / chunkCount;
    uint chunk = gl_WorkGroupID.x % chunkCount;
    uint lane = gl_LocalInvocationID.x;
    uint headsPerGroup = 32u / headDim;
    uint localHead = lane / headDim;
    uint feature = lane % headDim;
    uint head = gl_WorkGroupID.y * headsPerGroup + localHead;
    uint localBase = localHead * headDim;
    uint globalFeature = head * headDim + feature;
    uint projectionStride = 3u * modelDim + 2u * headCount;
    bool isActive = batch < batchSize && head < headCount;

    // One key row per lane; saved history and prefetched values remain FP16.
    float gradient[headDim];
    for (uint i = 0u; i < headDim; ++i) {
        uint k = i;
        uint index = ((batch * chunkCount + chunk) * headCount + head) * headDim * headDim +
                     feature * headDim + k;
        gradient[i] = isActive && chunkCount > 1u ? float(gradStateBoundaryBuffer.x[index]) : 0.0;
    }

    uint chunkBegin = chunk * chunkSize;
    uint chunkEnd = min(sequenceLength, chunkBegin + chunkSize);
    for (uint reversePosition = chunkEnd; reversePosition > chunkBegin;) {
        uint count = min(2u, reversePosition - chunkBegin);
        float16_t inputs[20];
        float16_t histories[3u * headDim];
        [[unroll]] for (uint step = 0u; step < 2u; ++step) {
            uint inputRow = batch * sequenceLength + reversePosition - 1u - step;
            uint inputStart = inputRow * projectionStride;
            uint inputGate = inputStart + 3u * modelDim + head;
            bool loadValue = isActive && step < count;
            inputs[step * 10u] =
                loadValue ? projectionBuffer.x[inputStart + globalFeature] : float16_t(0.0);
            inputs[step * 10u + 1u] =
                loadValue ? projectionBuffer.x[inputStart + modelDim + globalFeature]
                          : float16_t(0.0);
            inputs[step * 10u + 2u] =
                loadValue ? projectionBuffer.x[inputStart + 2u * modelDim + globalFeature]
                          : float16_t(0.0);
            inputs[step * 10u + 3u] = loadValue ? projectionBuffer.x[inputGate] : float16_t(0.0);
            inputs[step * 10u + 4u] =
                loadValue ? projectionBuffer.x[inputGate + headCount] : float16_t(0.0);
            inputs[step * 10u + 5u] = loadValue
                                          ? gradOutputBuffer.x[inputRow * modelDim + globalFeature]
                                          : float16_t(0.0);
            if (isPrepared) {
                inputs[step * 10u + 6u] =
                    loadValue ? rawProjectionBuffer.x[inputStart + globalFeature] : float16_t(0.0);
                inputs[step * 10u + 7u] =
                    loadValue ? rawProjectionBuffer.x[inputStart + modelDim + globalFeature]
                              : float16_t(0.0);
                inputs[step * 10u + 8u] =
                    loadValue ? rawProjectionBuffer.x[inputGate] : float16_t(0.0);
                inputs[step * 10u + 9u] =
                    loadValue ? rawProjectionBuffer.x[inputGate + headCount] : float16_t(0.0);
            }
        }
        [[unroll]] for (uint step = 0u; step < 3u; ++step) {
            uint rowIndex = batch * sequenceLength + reversePosition - 1u - step;
            bool loadHistory =
                isActive && step <= count && reversePosition > step && (!isPrepared || step > 0u);
            if (headDim >= 4u) {
                [[unroll]] for (uint i = 0u; i < headDim; i += 4u) {
                    uint value = i;
                    uint index = historyIndex(rowIndex, head, headDim, feature, value);
                    f16vec4 packed =
                        loadHistory ? BufferFp16x4(stateHistoryBuffer).x[index / 4u] : f16vec4(0.0);
                    histories[step * headDim + i] = packed.x;
                    histories[step * headDim + i + 1u] = packed.y;
                    histories[step * headDim + i + 2u] = packed.z;
                    histories[step * headDim + i + 3u] = packed.w;
                }
            } else {
                [[unroll]] for (uint i = 0u; i < headDim; ++i) {
                    uint value = i;
                    histories[step * headDim + i] =
                        loadHistory ? stateHistoryBuffer
                                          .x[historyIndex(rowIndex, head, headDim, feature, value)]
                                    : float16_t(0.0);
                }
            }
        }
        [[unroll]] for (uint step = 0u; step < 2u; ++step) {
            if (step < count) {
                uint position = reversePosition - 1u - step;
                uint row = batch * sequenceLength + position;
                uint projectionStart = row * projectionStride;
                uint vectorStart = row * modelDim + head * headDim;
                uint gateIndex = projectionStart + 3u * modelDim + head;
                uint pair = globalFeature / 2u;
                float angle = float(position) * pow(ropeBase, -2.0 * float(pair) / float(modelDim));
                float c = cos(angle);
                float s = sin(angle);
                float rawQuery = isActive ? float(inputs[step * 10u]) : 0.0;
                float rawKey = isActive ? float(inputs[step * 10u + 1u]) : 0.0;
                float normalizedQuery, normalizedKey, decayValue, writeValue, inverseQueryNorm,
                    inverseKeyNorm;
                float gradientQuery, gradientKey, derivativeDecay, derivativeWrite;
                if (isPrepared) {
                    normalizedQuery = rawQuery;
                    normalizedKey = rawKey;
                    decayValue = isActive ? float(inputs[step * 10u + 3u]) : 0.0;
                    writeValue = isActive ? float(inputs[step * 10u + 4u]) : 0.0;
                    float q = float(inputs[step * 10u + 6u]);
                    float k = float(inputs[step * 10u + 7u]);
                    float pairedQ = subgroupShuffleXor(q, 1u), pairedK = subgroupShuffleXor(k, 1u);
                    q = float(float16_t((feature & 1u) == 0u ? q * c - pairedQ * s
                                                             : pairedQ * s + q * c));
                    k = float(float16_t((feature & 1u) == 0u ? k * c - pairedK * s
                                                             : pairedK * s + k * c));
                    inverseQueryNorm = inversesqrt(headSum(q * q, headDim) + 1.0e-6);
                    inverseKeyNorm = inversesqrt(headSum(k * k, headDim) + 1.0e-6);
                    gradientQuery = q * inverseQueryNorm;
                    gradientKey = k * inverseKeyNorm;
                    derivativeDecay = 1.0 / (1.0 + exp(float(inputs[step * 10u + 8u]) + decayBias));
                    derivativeWrite = 1.0 / (1.0 + exp(-float(inputs[step * 10u + 9u])));
                } else {
                    float pairedQuery = subgroupShuffleXor(rawQuery, 1u);
                    float pairedKey = subgroupShuffleXor(rawKey, 1u);
                    float rotatedQuery = (feature & 1u) == 0u ? rawQuery * c - pairedQuery * s
                                                              : pairedQuery * s + rawQuery * c;
                    float rotatedKey = (feature & 1u) == 0u ? rawKey * c - pairedKey * s
                                                            : pairedKey * s + rawKey * c;
                    rotatedQuery = float(float16_t(rotatedQuery));
                    rotatedKey = float(float16_t(rotatedKey));
                    inverseQueryNorm =
                        inversesqrt(headSum(rotatedQuery * rotatedQuery, headDim) + 1.0e-6);
                    inverseKeyNorm =
                        inversesqrt(headSum(rotatedKey * rotatedKey, headDim) + 1.0e-6);
                    normalizedQuery = rotatedQuery * inverseQueryNorm;
                    normalizedKey = rotatedKey * inverseKeyNorm;
                    decayValue = isActive
                                     ? 1.0 / (1.0 + exp(float(inputs[step * 10u + 3u]) + decayBias))
                                     : 0.0;
                    writeValue =
                        isActive ? 1.0 / (1.0 + exp(-float(inputs[step * 10u + 4u]))) : 0.0;
                    gradientQuery = normalizedQuery;
                    gradientKey = normalizedKey;
                    derivativeDecay = decayValue;
                    derivativeWrite = writeValue;
                }

                float outputGradient = isActive ? float(inputs[step * 10u + 5u]) : 0.0;

                float savedValue = isActive ? float(inputs[step * 10u + 2u]) : 0.0;
                float queryGradient = 0.0;
                float predicted = 0.0;
                float readGradientValue = 0.0;
                float previous[headDim];
                for (uint i = 0u; i < headDim; ++i) {
                    uint v = i;
                    float dy = subgroupShuffle(outputGradient, localBase + v);
                    previous[i] = isActive ? float(histories[(step + 1u) * headDim + i]) : 0.0;
                    float current = isPrepared
                                        ? decayValue * previous[i] +
                                              normalizedKey * writeValue *
                                                  subgroupShuffle(savedValue, localBase + v)
                                        : (isActive ? float(histories[step * headDim + i]) : 0.0);
                    queryGradient += current * dy;
                    gradient[i] += normalizedQuery * dy;
                    float read = headSum(normalizedKey * gradient[i], headDim);
                    if (feature == v)
                        readGradientValue = read;
                    if (!isPrepared) {
                        float prediction =
                            headSum(normalizedKey * decayValue * previous[i], headDim);
                        if (feature == v)
                            predicted = prediction;
                    }
                }
                float errorValue = isPrepared ? savedValue : savedValue - predicted;
                float updateGradient = writeValue * readGradientValue;
                if (isActive)
                    gradProjectionBuffer.x[projectionStart + 2u * modelDim + globalFeature] =
                        float16_t(updateGradient);

                float keyGradient = 0.0;
                float rowReduction = 0.0;
                for (uint i = 0u; i < headDim; ++i) {
                    uint v = i;
                    float update = subgroupShuffle(updateGradient, localBase + v);
                    keyGradient +=
                        writeValue * gradient[i] * subgroupShuffle(errorValue, localBase + v) -
                        decayValue * previous[i] * update;
                    gradient[i] -= normalizedKey * update;
                    rowReduction += gradient[i] * previous[i];
                    gradient[i] *= decayValue;
                }
                float gradWrite = headSum(readGradientValue * errorValue, headDim);
                float gradDecay = headSum(rowReduction, headDim);
                float queryGradDot = headSum(queryGradient * gradientQuery, headDim);
                float keyGradDot = headSum(keyGradient * gradientKey, headDim);
                if (isActive && feature == 0u) {
                    gradProjectionBuffer.x[gateIndex] =
                        float16_t(gradDecay * (-derivativeDecay * (1.0 - derivativeDecay)));
                    gradProjectionBuffer.x[gateIndex + headCount] =
                        float16_t(gradWrite * derivativeWrite * (1.0 - derivativeWrite));
                }

                float rotatedQueryGradient =
                    inverseQueryNorm * (queryGradient - gradientQuery * queryGradDot);
                float rotatedKeyGradient =
                    inverseKeyNorm * (keyGradient - gradientKey * keyGradDot);
                rotatedQueryGradient = float(float16_t(rotatedQueryGradient));
                rotatedKeyGradient = float(float16_t(rotatedKeyGradient));
                float pairedQueryGradient = subgroupShuffleXor(rotatedQueryGradient, 1u);
                float pairedKeyGradient = subgroupShuffleXor(rotatedKeyGradient, 1u);
                if (isActive) {
                    float rawQueryGradient =
                        (feature & 1u) == 0u ? rotatedQueryGradient * c + pairedQueryGradient * s
                                             : -pairedQueryGradient * s + rotatedQueryGradient * c;
                    float rawKeyGradient = (feature & 1u) == 0u
                                               ? rotatedKeyGradient * c + pairedKeyGradient * s
                                               : -pairedKeyGradient * s + rotatedKeyGradient * c;
                    gradProjectionBuffer.x[projectionStart + globalFeature] =
                        float16_t(rawQueryGradient);
                    gradProjectionBuffer.x[projectionStart + modelDim + globalFeature] =
                        float16_t(rawKeyGradient);
                }
            }
        }
        reversePosition -= count;
    }
}
