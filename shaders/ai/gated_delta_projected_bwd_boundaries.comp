#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_control_flow_attributes : enable

layout(buffer_reference) buffer BufferFp16 { float16_t x[]; };

PUSH(
    BufferFp16 projectionBuffer;
    BufferFp16 gradOutputBuffer;
    BufferFp16 gradStateBoundaryBuffer;
    uint batchSize;
    uint sequenceLength;
    uint modelDim;
    uint headCount;
    float ropeBase;
    float decayBias;
    uint chunkSize;
)

CONSTANT(0) uint headDim = 4u;
CONSTANT(1) bool isPrepared = false;
const uint keyGroups = headDim < 32u / headDim ? headDim : 32u / headDim;
const uint keysPerLane = headDim / keyGroups;

float keySum(float value) {
    for (uint offset = keyGroups / 2u; offset > 0u; offset >>= 1u)
        value += subgroupShuffleXor(value, offset * headDim);
    return value;
}

float headSum(float value, uint headDim) {
    for (uint offset = headDim / 2u; offset > 0u; offset >>= 1u) {
        value += subgroupShuffleXor(value, offset);
    }
    return value;
}

COMPUTE(32, 1, 1)
void main() {
    uint batch = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    uint headsPerGroup = 32u / (headDim * keyGroups);
    uint localHead = lane / (headDim * keyGroups);
    uint keyGroup = (lane / headDim) % keyGroups;
    uint feature = lane % headDim;
    uint head = gl_WorkGroupID.y * headsPerGroup + localHead;
    uint localBase = localHead * headDim * keyGroups;
    uint globalFeature = head * headDim + feature;
    uint projectionStride = 3u * modelDim + 2u * headCount;
    uint chunkCount = (sequenceLength + chunkSize - 1u) / chunkSize;
    bool isActive = batch < batchSize && head < headCount;

    // Split each value column across lanes; only the accumulator is FP32.
    float gradient[keysPerLane];
    for (uint i = 0u; i < keysPerLane; ++i)
        gradient[i] = 0.0;

    for (uint reverseChunk = chunkCount; reverseChunk > 0u; --reverseChunk) {
        uint chunk = reverseChunk - 1u;
        if (isActive) {
            uint boundaryStart =
                ((batch * chunkCount + chunk) * headCount + head) * headDim * headDim;
            for (uint i = 0u; i < keysPerLane; ++i) {
                uint key = keyGroup * keysPerLane + i;
                gradStateBoundaryBuffer.x[boundaryStart + key * headDim + feature] =
                    float16_t(gradient[i]);
            }
        }
        // No earlier chunk needs the gradient before the first token.
        if (chunk == 0u)
            break;
        uint begin = chunk * chunkSize;
        uint end = min(sequenceLength, begin + chunkSize);
        for (uint reversePosition = end; reversePosition > begin;) {
            uint count = min(16u, reversePosition - begin);
            float16_t inputs[80];
            [[unroll]] for (uint step = 0u; step < 16u; ++step) {
                uint rowIndex = batch * sequenceLength + reversePosition - 1u - step;
                uint inputStart = rowIndex * projectionStride;
                uint inputGate = inputStart + 3u * modelDim + head;
                bool loadValue = isActive && step < count;
                inputs[step * 5u] =
                    loadValue ? projectionBuffer.x[inputStart + globalFeature] : float16_t(0.0);
                inputs[step * 5u + 1u] =
                    loadValue ? projectionBuffer.x[inputStart + modelDim + globalFeature]
                              : float16_t(0.0);
                inputs[step * 5u + 2u] = loadValue ? projectionBuffer.x[inputGate] : float16_t(0.0);
                inputs[step * 5u + 3u] =
                    loadValue ? projectionBuffer.x[inputGate + headCount] : float16_t(0.0);
                inputs[step * 5u + 4u] =
                    loadValue ? gradOutputBuffer.x[rowIndex * modelDim + globalFeature]
                              : float16_t(0.0);
            }
            [[unroll]] for (uint step = 0u; step < 16u; ++step) {
                if (step < count) {
                    uint position = reversePosition - 1u - step;
                    uint row = batch * sequenceLength + position;
                    uint start = row * projectionStride;
                    uint gate = start + 3u * modelDim + head;
                    float angle = float(position) *
                                  pow(ropeBase, -2.0 * float(globalFeature / 2u) / float(modelDim));
                    float c = cos(angle);
                    float s = sin(angle);
                    float q = isActive ? float(inputs[step * 5u]) : 0.0;
                    float k = isActive ? float(inputs[step * 5u + 1u]) : 0.0;
                    float decay, write;
                    if (isPrepared) {
                        decay = isActive ? float(inputs[step * 5u + 2u]) : 0.0;
                        write = isActive ? float(inputs[step * 5u + 3u]) : 0.0;
                    } else {
                        float pairedQ = subgroupShuffleXor(q, 1u);
                        float pairedK = subgroupShuffleXor(k, 1u);
                        q = float(float16_t((feature & 1u) == 0u ? q * c - pairedQ * s
                                                                 : pairedQ * s + q * c));
                        k = float(float16_t((feature & 1u) == 0u ? k * c - pairedK * s
                                                                 : pairedK * s + k * c));
                        q *= inversesqrt(headSum(q * q, headDim) + 1.0e-6);
                        k *= inversesqrt(headSum(k * k, headDim) + 1.0e-6);
                        decay = isActive
                                    ? 1.0 / (1.0 + exp(float(inputs[step * 5u + 2u]) + decayBias))
                                    : 0.0;
                        write = isActive ? 1.0 / (1.0 + exp(-float(inputs[step * 5u + 3u]))) : 0.0;
                    }
                    float dy = isActive ? float(inputs[step * 5u + 4u]) : 0.0;
                    float read = 0.0;
                    for (uint i = 0u; i < keysPerLane; ++i) {
                        uint key = keyGroup * keysPerLane + i;
                        gradient[i] += subgroupShuffle(q, localBase + key) * dy;
                        read += subgroupShuffle(k, localBase + key) * gradient[i];
                    }
                    read = keySum(read);
                    // G_previous = alpha * (I - beta * k * k^T) * G.
                    for (uint i = 0u; i < keysPerLane; ++i) {
                        uint key = keyGroup * keysPerLane + i;
                        gradient[i] = decay * (gradient[i] -
                                               write * subgroupShuffle(k, localBase + key) * read);
                    }
                }
            }
            reversePosition -= count;
        }
    }
}
