#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(buffer_reference) buffer BufferFp16 { float16_t x[]; };

PUSH(
    BufferFp16 projectionBuffer;
    BufferFp16 gradOutputBuffer;
    BufferFp16 gradStateBoundaryBuffer;
    uint batchSize;
    uint sequenceLength;
    uint modelDim;
    uint headCount;
    float ropeBase;
    float decayBias;
    uint chunkSize;
)

const uint MAX_HEAD_DIM = 32u;

float headSum(float value, uint headDim) {
    for (uint offset = headDim / 2u; offset > 0u; offset >>= 1u) {
        value += subgroupShuffleXor(value, offset);
    }
    return value;
}

COMPUTE(32, 1, 1)
void main() {
    uint batch = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    uint headDim = modelDim / headCount;
    uint head = gl_WorkGroupID.y * (32u / headDim) + lane / headDim;
    uint feature = lane % headDim;
    uint localBase = (lane / headDim) * headDim;
    uint globalFeature = head * headDim + feature;
    uint projectionStride = 3u * modelDim + 2u * headCount;
    uint chunkCount = (sequenceLength + chunkSize - 1u) / chunkSize;
    bool isActive = batch < batchSize && head < headCount;

    // One row of the state adjoint per lane, accumulated temporarily in FP32.
    float gradient[MAX_HEAD_DIM];
    for (uint v = 0u; v < headDim; ++v) gradient[v] = 0.0;

    for (uint reverseChunk = chunkCount; reverseChunk > 0u; --reverseChunk) {
        uint chunk = reverseChunk - 1u;
        if (isActive) {
            uint boundaryStart =
                ((batch * chunkCount + chunk) * headCount + head) * headDim * headDim;
            for (uint v = 0u; v < headDim; ++v) {
                gradStateBoundaryBuffer.x[boundaryStart + feature * headDim + v] =
                    float16_t(gradient[v]);
            }
        }
        // No earlier chunk needs the gradient before the first token.
        if (chunk == 0u) break;
        uint begin = chunk * chunkSize;
        uint end = min(sequenceLength, begin + chunkSize);
        for (uint reversePosition = end; reversePosition > begin; --reversePosition) {
            uint position = reversePosition - 1u;
            uint row = batch * sequenceLength + position;
            uint start = row * projectionStride;
            uint gate = start + 3u * modelDim + head;
            float angle = float(position) *
                pow(ropeBase, -2.0 * float(globalFeature / 2u) / float(modelDim));
            float c = cos(angle);
            float s = sin(angle);
            float q = isActive ? float(projectionBuffer.x[start + globalFeature]) : 0.0;
            float k = isActive ? float(projectionBuffer.x[start + modelDim + globalFeature]) : 0.0;
            float pairedQ = subgroupShuffleXor(q, 1u);
            float pairedK = subgroupShuffleXor(k, 1u);
            q = float(float16_t((feature & 1u) == 0u ? q * c - pairedQ * s : pairedQ * s + q * c));
            k = float(float16_t((feature & 1u) == 0u ? k * c - pairedK * s : pairedK * s + k * c));
            q *= inversesqrt(headSum(q * q, headDim) + 1.0e-6);
            k *= inversesqrt(headSum(k * k, headDim) + 1.0e-6);
            float decay = isActive
                ? 1.0 / (1.0 + exp(float(projectionBuffer.x[gate]) + decayBias)) : 0.0;
            float write = isActive
                ? 1.0 / (1.0 + exp(-float(projectionBuffer.x[gate + headCount]))) : 0.0;
            float dy = isActive
                ? float(gradOutputBuffer.x[row * modelDim + globalFeature]) : 0.0;
            for (uint v = 0u; v < headDim; ++v) {
                float g = gradient[v] + q * subgroupShuffle(dy, localBase + v);
                // G_previous = alpha * (I - beta * k * k^T) * G.
                gradient[v] = decay * (g - write * k * headSum(k * g, headDim));
            }
        }
    }
}
