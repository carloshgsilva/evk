#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable

layout(buffer_reference) buffer BufferFp16 { float16_t x[]; };

PUSH(
    BufferFp16 projectionBuffer;
    BufferFp16 gradStateBoundaryBuffer;
    uint batchSize;
    uint sequenceLength;
    uint modelDim;
    uint headCount;
    float decayBias;
    uint chunkSize;
)

const uint MAX_HEAD_DIM = 32u;
const uint WORKGROUP_WIDTH = 32u;
shared float gradState[WORKGROUP_WIDTH * MAX_HEAD_DIM];

uint localStateIndex(uint localHead, uint headDim,
                     uint keyFeature, uint valueFeature) {
    return localHead * headDim * headDim + keyFeature * headDim + valueFeature;
}

COMPUTE(32, 1, 1)
void main() {
    uint batch = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    uint headDim = modelDim / headCount;
    uint headsPerGroup = WORKGROUP_WIDTH / headDim;
    uint localHead = lane / headDim;
    uint feature = lane % headDim;
    uint head = gl_WorkGroupID.y * headsPerGroup + localHead;
    uint projectionStride = 3u * modelDim + 2u * headCount;
    uint chunkCount = (sequenceLength + chunkSize - 1u) / chunkSize;
    bool isActive = batch < batchSize && head < headCount;

    if (isActive) {
        for (uint valueFeature = 0u; valueFeature < headDim; ++valueFeature) {
            gradState[localStateIndex(localHead, headDim, feature, valueFeature)] = 0.0;
        }
    }

    for (uint reverseChunk = chunkCount; reverseChunk > 0u; --reverseChunk) {
        uint chunk = reverseChunk - 1u;
        float decayProduct = 1.0;
        uint chunkBegin = chunk * chunkSize;
        uint chunkEnd = min(sequenceLength, chunkBegin + chunkSize);
        if (isActive) {
            for (uint position = chunkBegin; position < chunkEnd; ++position) {
                uint gateIndex =
                    (batch * sequenceLength + position) * projectionStride +
                    3u * modelDim + head;
                decayProduct *= 1.0 / (1.0 + exp(
                    float(projectionBuffer.x[gateIndex]) + decayBias));
            }
            for (uint valueFeature = 0u; valueFeature < headDim; ++valueFeature) {
                uint stateIndex = localStateIndex(
                    localHead, headDim, feature, valueFeature);
                uint boundaryIndex =
                    ((((batch * chunkCount + chunk) * headCount + head) * headDim +
                       feature) * headDim + valueFeature);
                float chunkGradient = float(
                    gradStateBoundaryBuffer.x[boundaryIndex]);
                gradStateBoundaryBuffer.x[boundaryIndex] =
                    float16_t(gradState[stateIndex]);
                gradState[stateIndex] =
                    decayProduct * gradState[stateIndex] + chunkGradient;
            }
        }
    }
}
