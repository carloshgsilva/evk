#include "../common/evk.glsl"

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(buffer_reference) readonly buffer ReadBufferFp16 { float16_t x[]; };
layout(buffer_reference, buffer_reference_align = 8) readonly buffer ReadBufferFp16x4 {
    f16vec4 x[];
};
layout(buffer_reference) writeonly buffer WriteBufferFp16 { float16_t x[]; };
PUSH(
    ReadBufferFp16 inputTensor;
    ReadBufferFp16 weightTensor;
    ReadBufferFp16 biasTensor;
    WriteBufferFp16 outputTensor;
    uint width;
    uint height;
)

const uint MATRIX_SIZE = 16u;
const uint CHANNELS = 32u;
const uint CHANNEL_BLOCKS = 2u;
#ifdef OIDN_OUTPUT_N8
const uint MATRIX_N = 8u;
const uint CHANNEL_GROUPS = 1u;
const uint OUTPUT_CHANNELS = 8u;
#else
const uint MATRIX_N = 16u;
const uint CHANNEL_GROUPS = 2u;
const uint OUTPUT_CHANNELS = 32u;
#endif
const uint ROWS = 64u;
const uint ROW_TILES = ROWS / MATRIX_SIZE;
const uint OUTPUT_ROWS = 4u;
const uint POOLED_ROWS = OUTPUT_ROWS / 2u;
const uint STAGED_WIDTH = ROWS + 2u;
const uint STAGED_ROWS = OUTPUT_ROWS + 2u;
const uint STAGED_ELEMENTS = STAGED_ROWS * STAGED_WIDTH * MATRIX_SIZE;

shared f16vec4 inputTiles[STAGED_ELEMENTS / 4u];
#ifndef OIDN_NO_POOL
shared float16_t convolutionTiles[OUTPUT_ROWS * ROWS * OUTPUT_CHANNELS];
#endif

#ifdef OIDN_OUTPUT_N8
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
#else
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
#endif

f16vec4 load4(uint scalarIndex) {
    return ReadBufferFp16x4(uint64_t(inputTensor)).x[scalarIndex / 4u];
}

void main() {
    uint subgroup = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint outputRow = subgroup / CHANNEL_GROUPS;
    uint channelGroup = subgroup % CHANNEL_GROUPS;
    uint firstChannel = channelGroup * MATRIX_N;
    uint firstX = gl_WorkGroupID.x * ROWS;
    uint firstY = gl_WorkGroupID.y * OUTPUT_ROWS;
    uint loaderLane = gl_LocalInvocationID.x;

    coopmat<float16_t, gl_ScopeSubgroup, MATRIX_SIZE, MATRIX_N,
            gl_MatrixUseAccumulator> accum[ROW_TILES];
    for (uint rowTile = 0u; rowTile < ROW_TILES; ++rowTile) {
        accum[rowTile] = coopmat<float16_t, gl_ScopeSubgroup, MATRIX_SIZE,
                                 MATRIX_N, gl_MatrixUseAccumulator>(0.0);
    }

    bool interior = firstX > 0u && firstX + ROWS < width &&
                    firstY > 0u && firstY + OUTPUT_ROWS < height;
    for (uint channelBlock = 0u; channelBlock < CHANNEL_BLOCKS; ++channelBlock) {
        const uint vectorElements = STAGED_ELEMENTS / 4u;
        for (uint vectorIndex = loaderLane; vectorIndex < vectorElements;
             vectorIndex += gl_WorkGroupSize.x) {
            uint scalarIndex = vectorIndex * 4u;
            uint channel = channelBlock * MATRIX_SIZE + scalarIndex % MATRIX_SIZE;
            uint pixel = scalarIndex / MATRIX_SIZE;
            uint tileY = pixel / STAGED_WIDTH;
            uint tileX = pixel - tileY * STAGED_WIDTH;
            int inputY = int(firstY) + int(tileY) - 1;
            int inputX = int(firstX) + int(tileX) - 1;
            f16vec4 value = f16vec4(0.0);
            if (interior || (inputY >= 0 && inputY < int(height) &&
                             inputX >= 0 && inputX < int(width))) {
                uint inputIndex = (uint(inputY) * width + uint(inputX)) * CHANNELS +
                                  channel;
                value = load4(inputIndex);
            }
            inputTiles[vectorIndex] = value;
        }
        barrier();

        for (uint kernelOffset = 0u; kernelOffset < 9u; ++kernelOffset) {
            uint kernelY = kernelOffset / 3u;
            uint kernelX = kernelOffset - kernelY * 3u;
            uint chunkK = (channelBlock * 9u + kernelOffset) * MATRIX_SIZE;
            coopmat<float16_t, gl_ScopeSubgroup, MATRIX_SIZE, MATRIX_N,
                    gl_MatrixUseB> weights;
            coopMatLoad(weights, weightTensor.x,
                        chunkK * OUTPUT_CHANNELS + firstChannel,
                        OUTPUT_CHANNELS, gl_CooperativeMatrixLayoutRowMajor);
            for (uint rowTile = 0u; rowTile < ROW_TILES; ++rowTile) {
                coopmat<float16_t, gl_ScopeSubgroup, MATRIX_SIZE, MATRIX_SIZE,
                        gl_MatrixUseA> values;
                uint inputOffset = ((kernelY + outputRow) * STAGED_WIDTH +
                                    rowTile * MATRIX_SIZE + kernelX) * MATRIX_SIZE;
                coopMatLoad(values, inputTiles, inputOffset / 4u, MATRIX_SIZE / 4u,
                            gl_CooperativeMatrixLayoutRowMajor);
                accum[rowTile] = coopMatMulAdd(values, weights, accum[rowTile]);
            }
        }
        barrier();
    }

    coopmat<float16_t, gl_ScopeSubgroup, MATRIX_SIZE, MATRIX_N,
            gl_MatrixUseAccumulator> biasValues;
    coopMatLoad(biasValues, biasTensor.x, firstChannel, OUTPUT_CHANNELS,
                gl_CooperativeMatrixLayoutRowMajor);
    for (uint rowTile = 0u; rowTile < ROW_TILES; ++rowTile) {
        accum[rowTile] = accum[rowTile] + biasValues;
#ifndef OIDN_NO_RELU
        for (uint element = 0u; element < accum[rowTile].length(); ++element) {
            accum[rowTile][element] = max(float16_t(0.0), accum[rowTile][element]);
        }
#endif
#ifdef OIDN_NO_POOL
        uint outputX = firstX + rowTile * MATRIX_SIZE;
        uint outputY = firstY + outputRow;
        if (outputX < width && outputY < height) {
            coopMatStore(accum[rowTile], outputTensor.x,
                         (outputY * width + outputX) * OUTPUT_CHANNELS + firstChannel,
                         OUTPUT_CHANNELS, gl_CooperativeMatrixLayoutRowMajor);
        }
#else
        uint tileOffset = (outputRow * ROWS + rowTile * MATRIX_SIZE) * OUTPUT_CHANNELS +
                          firstChannel;
        coopMatStore(accum[rowTile], convolutionTiles, tileOffset, OUTPUT_CHANNELS,
                     gl_CooperativeMatrixLayoutRowMajor);
#endif
    }
#ifndef OIDN_NO_POOL
    barrier();

    const uint pooledRowElements = (ROWS / 2u) * OUTPUT_CHANNELS;
    const uint pooledElements = POOLED_ROWS * pooledRowElements;
    uint outputWidth = width / 2u;
    for (uint index = loaderLane; index < pooledElements;
         index += gl_WorkGroupSize.x) {
        uint pooledRow = index / pooledRowElements;
        uint rowIndex = index - pooledRow * pooledRowElements;
        uint pooledX = rowIndex / OUTPUT_CHANNELS;
        uint channel = rowIndex - pooledX * OUTPUT_CHANNELS;
        uint outputX = firstX / 2u + pooledX;
        if (outputX < outputWidth) {
            uint inputX = pooledX * 2u;
            uint top = (pooledRow * 2u * ROWS + inputX) * OUTPUT_CHANNELS + channel;
            uint bottom = ((pooledRow * 2u + 1u) * ROWS + inputX) * OUTPUT_CHANNELS +
                          channel;
            float16_t value = max(
                max(convolutionTiles[top], convolutionTiles[top + OUTPUT_CHANNELS]),
                max(convolutionTiles[bottom], convolutionTiles[bottom + OUTPUT_CHANNELS]));
            uint outputY = gl_WorkGroupID.y * POOLED_ROWS + pooledRow;
            outputTensor.x[(outputY * outputWidth + outputX) * OUTPUT_CHANNELS + channel] =
                value;
        }
    }
#endif
}
